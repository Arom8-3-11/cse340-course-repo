<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <meta name="author" content="Audrey Romrell">
</head>
<body>
    <nav class="site-navigation">
        <button class="nav-toggle" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false">
            <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <ul id="primary-navigation">
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>
            <% if (isLoggedIn) { %>
                <li><a href="/dashboard">My Dashboard</a></li>
                <li><a href="/logout">Logout</a></li>
            <% } else { %>
                <li><a href="/register">Register</a></li>
                <li><a href="/login">Login</a></li>
            <% } %>
        </ul>
    </nav>

    <% /* Reads and clears any flash messages set on the previous request, then renders them */ %>
    <% const flashMessages = typeof flash === 'function' ? flash() : null; %>
    <% if (flashMessages) { %>
        <% Object.keys(flashMessages).forEach(type => { %>
            <% flashMessages[type].forEach(message => { %>
                <div class="flash-message flash-<%= type %>"><%= message %></div>
            <% }); %>
        <% }); %>
    <% } %>