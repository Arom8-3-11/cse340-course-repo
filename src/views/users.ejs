<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (users.length > 0) { %>
        <div class="table-scroll">
            <table>
                <tbody>
                    <% let currentRole = null; users.forEach(registeredUser => { %>
                        <% const roleName = registeredUser.role_name || 'Unassigned'; if (roleName !== currentRole) { currentRole = roleName; %>
                            <tr class="users-role-row">
                                <th colspan="2" scope="rowgroup"><%= roleName %></th>
                            </tr>
                        <tr class="users-column-row">
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                        </tr>
                        <% } %>
                        <tr>
                            <td><%= registeredUser.name %></td>
                            <td><%= registeredUser.email %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <p>No users are registered yet.</p>
    <% } %>
</main>
<%- include('partials/footer') %>