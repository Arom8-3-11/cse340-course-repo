<%# 
  Single Service Project Details View
  Displays all details for an individual project, links back to its sponsoring organization,
  and displays category tags that link to category details pages.
%>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= project.title %></h2>

    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p><strong>Date:</strong> <%= new Date(project.project_date || project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <% if (user && user.role_name === 'admin') { %>
        <p><strong>Volunteers:</strong> <%= project.volunteer_count %></p>
    <% } %>
    
    <p><%= project.description %></p>

    <% if (user) { %>
        <% if (isVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" data-confirm-message="Are you sure you want to be removed from the project?">
                <button type="submit">Remove My Volunteer Signup</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for This Project</button>
            </form>
        <% } %>
    <% } %>

    <% if (categories && categories.length > 0) { %>
        <h3>Categories</h3>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
        <form class="delete-form" action="/delete-project/<%= project.project_id %>" method="POST" onsubmit="return confirm('Delete this project? Its category assignments will also be removed.')">
            <button class="button-danger" type="submit">Delete Project</button>
        </form>
    <% } %>
</main>
<%- include('partials/footer') %>
