<%# 
  Single Service Project Details View
  Displays all details for an individual project, links back to its sponsoring organization,
  and displays category tags that link to category details pages.
%>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= project.title %></h2>

    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p><strong>Date:</strong> <%= new Date(project.project_date || project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    
    <p><%= project.description %></p>

    <% if (categories && categories.length > 0) { %>
        <h3>Categories</h3>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } %>

    <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
</main>
<%- include('partials/footer') %>
