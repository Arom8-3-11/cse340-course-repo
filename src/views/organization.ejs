<%# 
  Organization Details View Template
  Renders the specific organization info (logo, description) and all associated service projects.
%>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= organization.name %></h2>

    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
    
    <p><%= organization.description %></p>

    <p><a href="/edit-organization/<%= organization.organization_id %>">Edit Organization</a></p>

    <h3>Service Projects</h3>
    <% if (projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    - <%= project.location %> (<%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>)
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects currently scheduled for this organization.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
