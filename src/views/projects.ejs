<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <p>Location: <%= project.location %></p>
                <%= new Date(project.project_date || project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:
                <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong>
                (<a href="/organization/<%= project.organization_id %>"><em><%= project.organization_name %></em></a>)
                <p><%= project.description %></p>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>